# URL do servidor Node.js que recebe os pulsos em tempo real
PLUVIOMETRO_API_URL="http://IP-DO-SERVIDOR-NODE:3000/api/pulses/batch"

# Chave gerada na aba "Raspberry Pi" do painel (ou igual a INGEST_API_KEY do servidor)
PLUVIOMETRO_API_KEY="COLE_SUA_CHAVE_AQUI"

# Configurações do sensor e fila local SQLite no Raspberry Pi
PLUVIOMETRO_GPIO="17"
PLUVIOMETRO_DEBOUNCE="0.2"
PLUVIOMETRO_MM_POR_PULSO="0.25"
PLUVIOMETRO_STATION_ID="default"
PLUVIOMETRO_QUEUE_DB="./pluviometro_fila.db"
