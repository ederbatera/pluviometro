# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Porta HTTP/WebSocket exposta pelo Docker Compose no host
APP_PORT="3000"

# MariaDB (Configurações, Usuários e Dados Consolidados)
# Preencha as variáveis MARIADB_* abaixo (ou descomente DATABASE_URL se preferir URL única):
MARIADB_HOST="mariadb"
MARIADB_PORT="3306"
MARIADB_DATABASE="pluviometro"
MARIADB_USER="root"
MARIADB_PASSWORD=
# DATABASE_URL="mysql://root:SUA_SENHA@mariadb:3306/pluviometro"

# Fila SQLite local (em desenvolvimento local usa ./prisma/queue.db; no Docker Compose usa /app/data/queue.db)
# SQLITE_QUEUE_PATH="./prisma/queue.db"

# INGEST_API_KEY: Chave secreta usada pelo Raspberry Pi no cabeçalho x-api-key ou apikey
INGEST_API_KEY=

# ADMIN_PASSWORD: Senha mestra opcional para acesso administrativo (Registros e Raspberry Pi)
ADMIN_PASSWORD=

# TZ_STATION: Fuso horário da estação pluviométrica
TZ_STATION="America/Sao_Paulo"

# TUNNEL_TOKEN: Opcional caso suba o serviço cloudflared pelo docker-compose.yml
# TUNNEL_TOKEN=
